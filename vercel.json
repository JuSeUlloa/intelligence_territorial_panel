{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/intelligence_territorial_panel/browser",
  "functions": {
    "api/dbx.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/dbx/:ruta*",
      "destination": "/api/dbx?ruta=:ruta*"
    }
  ]
}

